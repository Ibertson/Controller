# Copie para .env.local (ou cadastre na Vercel). Sem estas variáveis o app guarda os dados só no navegador.
# Supabase → Project Settings → Data API / API Keys. Use a chave pública (sb_publishable_...), nunca a secreta.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
